# FENCO 2.0 — Environment Variables
# Copy this to .env and fill in your values

NODE_ENV=development
PORT=3001

# Database (Docker Compose default)
DATABASE_URL=postgresql://fenco:fenco_password@localhost:5432/fenco_db

# Redis (Docker Compose default)
REDIS_URL=redis://localhost:6379

# REQUIRED: Get from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Models (verified 2026-09-22)
LLM_PRIMARY_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
EMBEDDING_PRIMARY_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=3072

# Scoring thresholds
SIMILARITY_THRESHOLD=0.65
COMPARISON_MATCH_THRESHOLD=0.70

# File upload
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Frontend URL (for CORS)
CORS_ORIGIN=http://localhost:5173

# Pipeline config
MAX_COUNTER_DRAFTS=5
